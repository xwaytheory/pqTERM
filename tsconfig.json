{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // src/shared modules import each other with explicit .ts so that
    // node --experimental-strip-types test scripts resolve them directly.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"],
      "@ort-wasm/*": ["node_modules/onnxruntime-web/dist/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/preload/**/*"
  ],
  // node --experimental-strip-types test scripts import with explicit .ts extensions
  // (see AGENTS.md) — they are executed by node, not compiled, so keep them out.
  "exclude": ["**/*.test.ts", "**/*.smoke.ts"]
}
