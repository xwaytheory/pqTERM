{
  "name": "pqterm",
  "version": "1.3.12",
  "description": "pqTERM — nerd terminal grid for AI coding agents",
  "main": "./out/main/index.js",
  "author": "pq",
  "license": "MIT",
  "productName": "pqTERM",
  "scripts": {
    "dev": "node scripts/pq.cjs dev",
    "build": "node scripts/pq.cjs build",
    "preview": "node scripts/pq.cjs preview",
    "start": "node scripts/pq.cjs preview",
    "rebuild": "node scripts/rebuild.cjs",
    "stamp": "node scripts/stamp-host.cjs",
    "shortcuts": "node scripts/make-shortcuts.cjs",
    "postinstall": "node scripts/rebuild.cjs && npm run build",
    "dist": "npm run build && electron-builder --win nsis msi",
    "new-work": "node scripts/new-work.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:version": "node scripts/check-version-sync.cjs",
    "test:unit": "npm run typecheck && node --experimental-strip-types --test src-tauri/commands.test.ts src/main/osc-title.test.ts src/main/pane-title.test.ts src/main/osc-notify.test.ts src/main/pane-activity.test.ts src/main/ws-coalesce.test.ts src/main/db-title.test.ts src/main/install-scripts.test.ts src/main/pqterm-update.test.ts src/main/profile-state.test.ts src/main/resume.test.ts src/main/board.test.ts src/main/trust.test.ts src/renderer/src/lib/dropPaths.test.ts src/renderer/src/lib/engineMarkLetter.test.ts src/renderer/src/components/engineLogoMeta.test.ts src/phone/src/originsMatch.test.ts src/phone/src/client.test.ts src/shared/grid.test.ts src/shared/order.test.ts src/shared/httpUrl.test.ts src/shared/term-stream.test.ts src/shared/term-geometry.test.ts src/shared/ui.test.ts"
  },
  "build": {
    "appId": "com.pqterm.app",
    "productName": "pqTERM",
    "executableName": "pqterm",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir",
      "icon": "resources/brand/pq.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "msi": {
      "oneClick": false,
      "upgradeCode": "3BBDA8F5-596C-47EF-9538-BDEF42EEBA06"
    },
    "files": [
      "out/**/*",
      "package.json",
      "resources/**/*",
      "!resources/brand/pq-master.jpg",
      "!**/{.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!crates{,/**/*}",
      "!release{,/**/*}",
      "!host{,/**/*}",
      "!android{,/**/*}",
      "!docs{,/**/*}",
      "!scripts{,/**/*}",
      "!**/*.ts",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node-pty/**"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
